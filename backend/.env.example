DB_HOST=localhost
DB_USER=root
DB_PW=
DB_NAME=trips_db
AUTH_SECRET=change-me-in-production
PORT=3200
NODE_ENV=development
SEQUELIZE_SYNC_ALTER=false
EMAIL_MODE=file
EMAIL_FILE_DIR=test-mail
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASSWORD_SECRET_ID=
SECRETS_AGENT_TOKEN_FILE=
# Document encryption key: production names the AWS secret; development sets its own key (openssl rand -base64 32).
FILE_ENCRYPTION_KEY_SECRET_ID=
FILE_ENCRYPTION_KEY=
# Personal data (database column) key, separate from the document key: production names the AWS secret; development sets its own key (openssl rand -base64 32). The server will not start without it.
PII_ENCRYPTION_KEY_SECRET_ID=
PII_ENCRYPTION_KEY=
SCHEDULED_EMAIL_TIMEZONE=America/Chicago
# Address of the web app, used in password reset links (production: https://missiontrips.app).
APP_URL=http://localhost:8082
