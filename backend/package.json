{
  "name": "trips-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Trips — Node.js REST API (imported from missiontrips-backend)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node app/scripts/seedRoles.js && node app/scripts/seedAirportsAirlines.js && node app/scripts/seedEmailTypes.js && node app/scripts/seedEmailTokens.js && node app/scripts/seedEmailTemplates.js && node app/scripts/seedDocumentTypes.js",
    "seed:catalogs": "node app/scripts/seedAirportsAirlines.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "bundle": "node scripts/make-deploy.mjs",
    "send-scheduled-emails": "node app/scripts/sendScheduledEmails.js"
  },
  "keywords": [
    "node.js",
    "express",
    "sequelize"
  ],
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "heic-convert": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.1.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "sequelize": "^6.37.5",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
